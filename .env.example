# Copy to .env and adjust. Never commit .env.
DATABASE_URL=sqlite:///./data/app.db
# Shared caseworker passcode for the review queue (empty = review queue always denied)
CASEWORKER_PASSCODE=
ASSESSOR=income_rule
RULE_THRESHOLD_AED=2000
RULE_BAND_UPPER_AED=2500
# Used by the Streamlit UI to reach the API
API_BASE_URL=http://127.0.0.1:8000
# Feature 004: uploaded documents are stored here (one folder per reference number)
UPLOAD_DIR=data/uploads
# Versioned decision rules in src/social_support/labelling/policies/<name>.toml
DECISION_POLICY=decision_v1
# Declared income may differ from bank statement income by this percentage
INCOME_TOLERANCE_PCT=10
# ID card fields read below this OCR confidence route the case to human review
OCR_MIN_CONFIDENCE=0.80
# Local LLM for economic enablement recommendations (qwen2.5:3b is the faster fallback)
OLLAMA_URL=http://localhost:11434
ENABLEMENT_MODEL=qwen2.5:7b
ENABLEMENT_TIMEOUT_S=90
