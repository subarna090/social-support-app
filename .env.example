# Copy to .env and adjust. Never commit .env.
DATABASE_URL=sqlite:///./data/app.db
# Shared caseworker passcode for the review queue (empty = review queue always denied)
CASEWORKER_PASSCODE=
ASSESSOR=income_rule
RULE_THRESHOLD_AED=2000
RULE_BAND_UPPER_AED=2500
# Used by the Streamlit UI to reach the API
API_BASE_URL=http://127.0.0.1:8000
